{
  "manifest_version": 3,
  "name": "TubePredict - YouTube Video CTR & Virality Predictor",
  "version": "1.0.0",
  "description": "Evaluate titles, duration, and upload schedules to predict top-quartile performance directly in YouTube Studio.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://studio.youtube.com/*",
    "*://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://studio.youtube.com/*",
        "*://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
